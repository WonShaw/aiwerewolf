{
  "name": "aiwerewolf",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "simulate": "AIWEREWOLF_NIGHT_MIN_MS=0 tsx scripts/simulate.ts",
    "check-isolation": "tsx scripts/check-isolation.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
